#!/bin/sh
# =====================================================================
#  sandboxed - run a command under the ai-sandbox Seatbelt profile.
#
#  Self-locating: uses the ai-sandbox.sb that sits next to this script in the
#  repo, so you can use it WITHOUT running install.sh:
#
#    cd ~/your/project
#    /path/to/ai-sandbox/sandboxed claude
#
#  Prefer the shell function? Run ./install.sh once, then just `sandboxed`.
# =====================================================================
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
SB="$SCRIPT_DIR/ai-sandbox.sb"

if [ ! -f "$SB" ]; then
  printf 'ERROR: ai-sandbox.sb not found at: %s\n' "$SB" >&2
  printf '       This script must stay next to ai-sandbox.sb in the repo.\n' >&2
  exit 1
fi

exec sandbox-exec -f "$SB" -D HOME="$HOME" -D WORKSPACE="$PWD" "$@"
