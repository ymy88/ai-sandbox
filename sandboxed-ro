#!/bin/sh
# =====================================================================
#  sandboxed-ro - run a command under the READ-ONLY ai-sandbox-ro profile.
#
#  Stricter sibling of `sandboxed`: the launch dir (WORKSPACE) is read-only,
#  so this is for querying / analyzing code without modifying it. See
#  ai-sandbox-ro.sb for the full policy.
#
#  Self-locating: uses the ai-sandbox-ro.sb that sits next to this script in
#  the repo, so you can use it WITHOUT running install.sh:
#
#    cd ~/your/project
#    /path/to/ai-sandbox/sandboxed-ro claude
#
#  Prefer the shell function? Run ./install.sh once, then just `sandboxed-ro`.
# =====================================================================
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
SB="$SCRIPT_DIR/ai-sandbox-ro.sb"

if [ ! -f "$SB" ]; then
  printf 'ERROR: ai-sandbox-ro.sb not found at: %s\n' "$SB" >&2
  printf '       This script must stay next to ai-sandbox-ro.sb in the repo.\n' >&2
  exit 1
fi

exec sandbox-exec -f "$SB" -D HOME="$HOME" -D WORKSPACE="$PWD" "$@"
